# Copy this file to .env and fill in real values.
# Variables marked REQUIRED are checked by config/env.validator.js;
# the server exits on startup if any are missing or invalid.

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------

# REQUIRED. One of: development, production, test
NODE_ENV=development

# Optional. Port the API listens on (default: 5000)
PORT=5000

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------

# REQUIRED. Must start with mongodb:// or mongodb+srv://
MONGODB_URI=mongodb://localhost:27017/dev-project-planner

# Optional. Comma-separated DNS servers for Node to use. Set this only if
# startup fails with "querySrv ECONNREFUSED" for a mongodb+srv:// URI
# (a local Windows resolver issue; not needed on Vercel or other hosts).
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------

# REQUIRED. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# REQUIRED. Token lifetime: a number followed by s, m, h or d (e.g. 15m, 1h, 7d)
JWT_EXPIRE=7d

# ---------------------------------------------------------------
# CORS
# ---------------------------------------------------------------

# REQUIRED. Allowed frontend origin(s), comma-separated, each a full URL
# e.g. http://localhost:5173,https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------
# Rate limiting (optional)
# ---------------------------------------------------------------

# Time window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per IP per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# Comma-separated IPs that bypass rate limiting (default: none)
TRUSTED_IPS=
